@model NotificationBellViewModel
<div class="dropdown">
    <button type="button" class="icon-btn" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Notifications">
        <i class="bi bi-bell"></i>
        @if (Model.UnreadCount > 0)
        {
            <span class="count">@(Model.UnreadCount > 9 ? "9+" : Model.UnreadCount.ToString())</span>
        }
    </button>
    <div class="dropdown-menu dropdown-menu-end notif-menu">
        <div class="d-flex justify-content-between align-items-center px-2 py-1">
            <strong>Notifications</strong>
            <a class="small" asp-controller="Notifications" asp-action="Index">See all</a>
        </div>
        @if (!Model.Latest.Any())
        {
            <div class="text-muted small px-2 py-3">You're all caught up.</div>
        }
        @foreach (var n in Model.Latest)
        {
            <form asp-controller="Notifications" asp-action="Open" asp-route-id="@n.Id" method="post">
                <button type="submit" class="notif-item">
                    <i class="bi @n.Type.Icon()"></i>
                    <span>
                        <strong>@n.Title</strong>
                        <span>@n.Message</span>
                        <small class="text-muted d-block">@n.CreatedAt.TimeAgo()</small>
                    </span>
                </button>
            </form>
        }
    </div>
</div>
