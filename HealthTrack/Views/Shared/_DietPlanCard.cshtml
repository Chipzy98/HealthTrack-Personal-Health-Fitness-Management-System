@model DietPlan
@* Reusable diet plan card. ViewData["ShowActions"] / ViewData["ShowClient"] work like _WorkoutPlanCard. *@
@{
    bool showActions = ViewData["ShowActions"] as bool? ?? false;
    bool showClient = ViewData["ShowClient"] as bool? ?? false;
    int planned = Model.Items.Sum(i => i.Calories);
}
<div class="plan-card @(Model.IsActive ? "" : "inactive")">
    <div class="plan-top">
        <div>
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <i class="bi bi-egg-fried text-warning"></i>
                <h3 class="h5 mb-0">@Model.Title</h3>
                <span class="pill tone-@(Model.IsActive ? "good" : "neutral")">@(Model.IsActive ? "Active" : "Inactive")</span>
            </div>
            <div class="small text-muted mt-1">
                @if (showClient && Model.Client != null) { <span><i class="bi bi-person"></i> @Model.Client.FullName ·</span> }
                @if (!showClient && Model.Trainer != null) { <span><i class="bi bi-person-badge"></i> @Model.Trainer.FullName ·</span> }
                Target @Model.DailyCalorieTarget kcal/day · @Model.StartDate.ToString("dd MMM") – @Model.EndDate.ToString("dd MMM yyyy")
            </div>
        </div>
        @if (showActions)
        {
            <div class="d-flex gap-2 align-items-start">
                <form asp-controller="Trainer" asp-action="TogglePlan" method="post">
                    <input type="hidden" name="planType" value="diet" />
                    <input type="hidden" name="id" value="@Model.Id" />
                    <button class="btn btn-sm btn-outline-primary" type="submit">@(Model.IsActive ? "Deactivate" : "Activate")</button>
                </form>
                <form asp-controller="Trainer" asp-action="DeletePlan" method="post" data-confirm="Delete this diet plan permanently?">
                    <input type="hidden" name="planType" value="diet" />
                    <input type="hidden" name="id" value="@Model.Id" />
                    <button class="btn btn-sm btn-outline-danger" type="submit" aria-label="Delete plan"><i class="bi bi-trash"></i></button>
                </form>
            </div>
        }
    </div>
    <div class="plan-body">
        @if (!string.IsNullOrEmpty(Model.Description))
        {
            <p class="text-muted">@Model.Description</p>
        }
        <ul class="list-plain">
            @foreach (var item in Model.Items.OrderBy(i => i.ScheduledTime))
            {
                <li class="list-row">
                    <div class="date-tile"><div class="d" style="font-size:.95rem">@DateTime.Today.Add(item.ScheduledTime).ToString("h:mm")</div><div class="m">@DateTime.Today.Add(item.ScheduledTime).ToString("tt")</div></div>
                    <div class="grow">
                        <div class="title">@item.MealType</div>
                        <div class="meta">@item.Description</div>
                    </div>
                    <span class="pill tone-neutral">@item.Calories kcal</span>
                </li>
            }
        </ul>
        <div class="small text-muted mt-2">Planned total: <strong>@planned kcal</strong> of @Model.DailyCalorieTarget kcal target</div>
    </div>
</div>
