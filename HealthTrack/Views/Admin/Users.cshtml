@model UserListViewModel
@{
    ViewData["Title"] = "Users";
    int myId = User.GetUserId();
}
<div class="page-head">
    <div>
        <h1>User management</h1>
        <p>@Model.Users.Count account(s) shown. Accounts are deactivated rather than deleted to keep health records intact.</p>
    </div>
    <a class="btn btn-primary" asp-action="CreateUser"><i class="bi bi-person-plus"></i> New user</a>
</div>

<div class="filter-bar">
    <a class="chip-link @(Model.RoleFilter == null ? "active" : "")" asp-action="Users" asp-route-search="@Model.Search">All</a>
    @foreach (var r in Enum.GetValues<UserRole>())
    {
        <a class="chip-link @(Model.RoleFilter == r ? "active" : "")" asp-action="Users" asp-route-role="@r" asp-route-search="@Model.Search">@(r)s</a>
    }
    <form asp-action="Users" method="get" class="ms-auto d-flex gap-2">
        @if (Model.RoleFilter.HasValue) { <input type="hidden" name="role" value="@Model.RoleFilter" /> }
        <input type="search" name="search" value="@Model.Search" class="form-control" placeholder="Name or email" aria-label="Search users" />
        <button class="btn btn-outline-primary" type="submit"><i class="bi bi-search"></i></button>
    </form>
</div>

<div class="panel flush">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead><tr><th>User</th><th>Role</th><th>Trainer / specialisation</th><th>Last sign-in</th><th>Status</th><th class="text-end">Actions</th></tr></thead>
            <tbody>
                @if (!Model.Users.Any())
                {
                    <tr><td colspan="6"><div class="empty"><i class="bi bi-search"></i><p>No users match your filter.</p></div></td></tr>
                }
                @foreach (var u in Model.Users)
                {
                    bool locked = u.LockoutEnd.HasValue && u.LockoutEnd > DateTime.Now;
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <span class="avatar">@u.Initials</span>
                                <div><div class="fw-semibold">@u.FullName</div><div class="small text-muted">@u.Email</div></div>
                            </div>
                        </td>
                        <td>@u.Role</td>
                        <td class="small">
                            @if (u.Role == UserRole.Client) { @(u.Trainer?.FullName ?? "Not assigned") }
                            else if (u.Role == UserRole.Trainer) { @u.Specialization }
                        </td>
                        <td class="small">@(u.LastLoginAt?.TimeAgo() ?? "Never")</td>
                        <td>
                            @if (!u.IsActive) { <span class="pill tone-neutral">Inactive</span> }
                            else if (!u.IsApproved) { <span class="pill tone-warn">Pending approval</span> }
                            else if (locked) { <span class="pill tone-alert">Locked</span> }
                            else { <span class="pill tone-good">Active</span> }
                        </td>
                        <td class="text-end">
                            <div class="d-inline-flex gap-1">
                                @if (u.Role == UserRole.Client)
                                {
                                    <a class="btn btn-sm btn-outline-primary" asp-controller="Progress" asp-action="Index" asp-route-clientId="@u.Id" title="Progress"><i class="bi bi-graph-up"></i></a>
                                }
                                <a class="btn btn-sm btn-outline-primary" asp-action="EditUser" asp-route-id="@u.Id" title="Edit"><i class="bi bi-pencil"></i></a>
                                @if (locked)
                                {
                                    <form asp-action="UnlockUser" asp-route-id="@u.Id" method="post">
                                        <button class="btn btn-sm btn-outline-primary" type="submit" title="Unlock"><i class="bi bi-unlock"></i></button>
                                    </form>
                                }
                                @if (u.Id != myId)
                                {
                                    <form asp-action="ToggleActive" asp-route-id="@u.Id" method="post"
                                          data-confirm="@(u.IsActive ? $"Deactivate {u.FullName}? They will no longer be able to sign in." : $"Reactivate {u.FullName}?")">
                                        <button class="btn btn-sm @(u.IsActive ? "btn-outline-danger" : "btn-outline-primary")" type="submit" title="@(u.IsActive ? "Deactivate" : "Reactivate")">
                                            <i class="bi @(u.IsActive ? "bi-person-x" : "bi-person-check")"></i>
                                        </button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
