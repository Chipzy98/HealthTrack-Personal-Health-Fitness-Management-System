@model ActivityLogViewModel
@{
    ViewData["Title"] = "Activity log";
}
<div class="page-head">
    <div>
        <h1>Activity log</h1>
        <p>@Model.TotalCount recorded event(s): sign-ins, failed attempts, data changes and admin actions.</p>
    </div>
</div>

<form asp-action="ActivityLogs" method="get" class="filter-bar">
    <div>
        <label class="form-label small" for="filter">Action</label>
        <select name="filter" id="filter" class="form-select" onchange="this.form.submit()">
            <option value="">All actions</option>
            @foreach (var a in Model.Actions)
            {
                if (a == Model.ActionFilter) { <option value="@a" selected>@a</option> }
                else { <option value="@a">@a</option> }
            }
        </select>
    </div>
</form>

<div class="panel flush">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead><tr><th>Time</th><th>User</th><th>Action</th><th>Details</th><th>IP address</th></tr></thead>
            <tbody>
                @if (!Model.Logs.Any())
                {
                    <tr><td colspan="5"><div class="empty"><i class="bi bi-list-check"></i><p>No events found.</p></div></td></tr>
                }
                @foreach (var log in Model.Logs)
                {
                    <tr>
                        <td class="small">@log.Timestamp.ToString("dd MMM yyyy, h:mm:ss tt")</td>
                        <td>@(log.User?.FullName ?? "–")<div class="small text-muted">@log.User?.Role</div></td>
                        <td><span class="pill tone-@(log.Action == "LoginFailed" ? "alert" : log.Action == "Login" ? "good" : "neutral")">@log.Action</span></td>
                        <td class="small">@log.Details</td>
                        <td class="small text-muted">@log.IpAddress</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-3" aria-label="Pages">
        <ul class="pagination">
            <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                <a class="page-link" asp-action="ActivityLogs" asp-route-filter="@Model.ActionFilter" asp-route-page="@(Model.Page - 1)">Previous</a>
            </li>
            <li class="page-item disabled"><span class="page-link">Page @Model.Page of @Model.TotalPages</span></li>
            <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                <a class="page-link" asp-action="ActivityLogs" asp-route-filter="@Model.ActionFilter" asp-route-page="@(Model.Page + 1)">Next</a>
            </li>
        </ul>
    </nav>
}
