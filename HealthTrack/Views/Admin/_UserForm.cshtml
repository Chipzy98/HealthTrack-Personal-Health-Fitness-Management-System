@model AdminUserFormViewModel
@* Shared fields for CreateUser and EditUser. *@
@{
    bool isEdit = Model.Id > 0;
}
<div asp-validation-summary="ModelOnly" class="mb-3"></div>
<input type="hidden" asp-for="Id" />
<div class="row g-3">
    <div class="col-md-6">
        <label asp-for="FullName" class="form-label"></label>
        <input asp-for="FullName" class="form-control" />
        <span asp-validation-for="FullName" class="field-validation-error"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" />
        <span asp-validation-for="Email" class="field-validation-error"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Role" class="form-label"></label>
        <select asp-for="Role" asp-items="Html.GetEnumSelectList<UserRole>()" class="form-select"></select>
    </div>
    <div class="col-md-4">
        <label asp-for="Password" class="form-label">@(isEdit ? "New password (optional)" : "Password")</label>
        <input asp-for="Password" class="form-control" autocomplete="new-password" />
        <span asp-validation-for="Password" class="field-validation-error"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="PhoneNumber" class="form-label"></label>
        <input asp-for="PhoneNumber" class="form-control" />
        <span asp-validation-for="PhoneNumber" class="field-validation-error"></span>
    </div>
    <div class="col-md-6 role-trainer">
        <label asp-for="Specialization" class="form-label"></label>
        <input asp-for="Specialization" class="form-control" placeholder="e.g. Physiotherapist" />
        <span asp-validation-for="Specialization" class="field-validation-error"></span>
    </div>
    <div class="col-md-6 role-client">
        <label asp-for="TrainerId" class="form-label"></label>
        <select asp-for="TrainerId" asp-items="Model.Trainers" class="form-select">
            <option value="">No trainer</option>
        </select>
        <span asp-validation-for="TrainerId" class="field-validation-error"></span>
    </div>
    <div class="col-12 d-flex gap-4">
        <div class="form-check form-switch">
            <input asp-for="IsActive" class="form-check-input" />
            <label asp-for="IsActive" class="form-check-label"></label>
        </div>
        <div class="form-check form-switch role-trainer">
            <input asp-for="IsApproved" class="form-check-input" />
            <label asp-for="IsApproved" class="form-check-label">Trainer approved</label>
        </div>
    </div>
</div>

<script>
    // Show only the fields that apply to the selected role.
    (function () {
        const role = document.getElementById('Role');
        function refresh() {
            const value = role.value; // 0 = Client, 1 = Trainer, 2 = Admin
            document.querySelectorAll('.role-trainer').forEach(el => el.style.display = value === '1' ? '' : 'none');
            document.querySelectorAll('.role-client').forEach(el => el.style.display = value === '0' ? '' : 'none');
        }
        role.addEventListener('change', refresh);
        refresh();
    })();
</script>
