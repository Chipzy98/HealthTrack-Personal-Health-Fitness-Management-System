@model TrainerPlansViewModel
@{
    ViewData["Title"] = "Plans";
    var cardData = new ViewDataDictionary(ViewData) { ["ShowActions"] = true, ["ShowClient"] = true };
}
<div class="page-head">
    <div>
        <h1>Workout &amp; diet plans</h1>
        <p>Plans you've created for your clients. Deactivate a plan to hide it from the client's dashboard.</p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a class="btn btn-primary" asp-action="CreateWorkoutPlan"><i class="bi bi-plus-lg"></i> Workout plan</a>
        <a class="btn btn-outline-primary" asp-action="CreateDietPlan"><i class="bi bi-plus-lg"></i> Diet plan</a>
    </div>
</div>

<ul class="nav nav-pills mb-3" role="tablist">
    <li class="nav-item"><button class="nav-link active" data-bs-toggle="pill" data-bs-target="#workoutPlans" type="button">Workout plans (@Model.WorkoutPlans.Count)</button></li>
    <li class="nav-item"><button class="nav-link" data-bs-toggle="pill" data-bs-target="#dietPlans" type="button">Diet plans (@Model.DietPlans.Count)</button></li>
</ul>
<div class="tab-content">
    <div class="tab-pane fade show active" id="workoutPlans">
        @if (!Model.WorkoutPlans.Any())
        {
            <div class="panel"><div class="empty"><i class="bi bi-clipboard2"></i><p>You haven't created any workout plans yet.</p></div></div>
        }
        @foreach (var plan in Model.WorkoutPlans)
        {
            <partial name="_WorkoutPlanCard" model="plan" view-data="cardData" />
        }
    </div>
    <div class="tab-pane fade" id="dietPlans">
        @if (!Model.DietPlans.Any())
        {
            <div class="panel"><div class="empty"><i class="bi bi-egg"></i><p>You haven't created any diet plans yet.</p></div></div>
        }
        @foreach (var plan in Model.DietPlans)
        {
            <partial name="_DietPlanCard" model="plan" view-data="cardData" />
        }
    </div>
</div>
