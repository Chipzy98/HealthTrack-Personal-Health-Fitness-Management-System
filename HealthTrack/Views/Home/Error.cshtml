@model ErrorViewModel
@{
    ViewData["Title"] = "Something went wrong";
}
<div class="panel text-center py-5">
    <div class="empty">
        <i class="bi bi-exclamation-octagon"></i>
        <h1 class="h3 mt-2">Something went wrong</h1>
        <p class="text-muted">An unexpected error occurred while processing your request. Please try again.</p>
        @if (Model?.ShowRequestId == true)
        {
            <p class="small text-muted">Reference: <code>@Model.RequestId</code></p>
        }
        <a class="btn btn-primary mt-2" asp-controller="Home" asp-action="Index">Back to home</a>
    </div>
</div>
