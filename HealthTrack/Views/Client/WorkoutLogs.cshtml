@model List<WorkoutLog>
@{
    ViewData["Title"] = "Workouts";
    int totalMinutes = Model.Sum(w => w.DurationMinutes);
    int totalCalories = Model.Sum(w => w.CaloriesBurned);
}
<div class="page-head">
    <div>
        <h1>Workout log</h1>
        <p>Your activity from the last 90 days.</p>
    </div>
    <a class="btn btn-primary" asp-action="LogWorkout"><i class="bi bi-plus-lg"></i> Log workout</a>
</div>

<div class="stat-grid">
    <div class="stat"><div class="label">Sessions</div><div class="value">@Model.Count</div></div>
    <div class="stat"><div class="label">Total minutes</div><div class="value">@totalMinutes</div></div>
    <div class="stat"><div class="label">Calories burned</div><div class="value">@totalCalories</div></div>
    <div class="stat"><div class="label">Average session</div><div class="value">@(Model.Count > 0 ? totalMinutes / Model.Count : 0) <small class="fs-6 text-muted">min</small></div></div>
</div>

<div class="panel flush">
    <div class="panel-head"><h2>History</h2></div>
    @if (!Model.Any())
    {
        <div class="empty"><i class="bi bi-activity"></i><p>No workouts logged in the last 90 days.</p></div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr><th>Date</th><th>Exercise</th><th>Duration</th><th>Intensity</th><th>Sets × reps</th><th>Calories</th><th>Notes</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var w in Model)
                    {
                        <tr>
                            <td>@w.Date.ToString("ddd dd MMM")</td>
                            <td class="fw-semibold">@w.ExerciseName</td>
                            <td>@w.DurationMinutes min</td>
                            <td><span class="pill tone-@(w.Intensity == WorkoutIntensity.High ? "alert" : w.Intensity == WorkoutIntensity.Moderate ? "warn" : "good")">@w.Intensity</span></td>
                            <td>@(w.Sets.HasValue ? $"{w.Sets} × {w.Reps}" : "–")</td>
                            <td>@w.CaloriesBurned kcal</td>
                            <td class="small text-muted">@w.Notes</td>
                            <td class="text-end">
                                <form asp-action="DeleteWorkout" asp-route-id="@w.Id" method="post" data-confirm="Delete this workout entry?">
                                    <button class="btn btn-sm btn-outline-danger" type="submit" aria-label="Delete"><i class="bi bi-trash"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
