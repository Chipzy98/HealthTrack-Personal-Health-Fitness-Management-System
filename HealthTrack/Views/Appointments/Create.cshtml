@model AppointmentFormViewModel
@{
    ViewData["Title"] = "Book appointment";
}
<div class="page-head">
    <div>
        <h1>Book an appointment</h1>
        <p>Your request is sent to the professional, who approves or suggests another time.</p>
    </div>
    <a class="btn btn-outline-primary" asp-action="Index"><i class="bi bi-arrow-left"></i> Back</a>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="panel">
            <form asp-action="Create" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="mb-3"></div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="TrainerId" class="form-label"></label>
                        <select asp-for="TrainerId" asp-items="Model.Trainers" class="form-select">
                            <option value="">Choose…</option>
                        </select>
                        <span asp-validation-for="TrainerId" class="field-validation-error"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Type" class="form-label"></label>
                        <select asp-for="Type" asp-items="Html.GetEnumSelectList<AppointmentType>()" class="form-select"></select>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="ScheduledAt" class="form-label"></label>
                        <input asp-for="ScheduledAt" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}" class="form-control"
                               min="@DateTime.Now.AddHours(1).ToString("yyyy-MM-ddTHH:mm")" />
                        <span asp-validation-for="ScheduledAt" class="field-validation-error"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="DurationMinutes" class="form-label"></label>
                        <select asp-for="DurationMinutes" class="form-select">
                            <option value="30">30 minutes</option>
                            <option value="45">45 minutes</option>
                            <option value="60">1 hour</option>
                            <option value="90">1.5 hours</option>
                        </select>
                        <span asp-validation-for="DurationMinutes" class="field-validation-error"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Reason" class="form-label"></label>
                        <textarea asp-for="Reason" class="form-control" rows="3" placeholder="e.g. Knee pain during squats, want to review my diet plan"></textarea>
                        <span asp-validation-for="Reason" class="field-validation-error"></span>
                    </div>
                </div>
                <button type="submit" class="btn btn-primary mt-4"><i class="bi bi-send"></i> Send request</button>
            </form>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="panel">
            <div class="panel-head"><h2>Booking rules</h2></div>
            <ul class="small text-muted mb-0 ps-3">
                <li class="mb-2">Sessions run between 6:00 AM and 9:00 PM.</li>
                <li class="mb-2">Book at least 1 hour ahead and no more than 3 months ahead.</li>
                <li class="mb-2">Overlapping bookings are not allowed.</li>
                <li>You'll get a notification when the request is approved, and a reminder before the session.</li>
            </ul>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
