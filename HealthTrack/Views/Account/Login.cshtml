@model LoginViewModel
@{
    ViewData["Title"] = "Sign in";
}
<div class="auth-wrap">
    <div class="auth-side">
        <div>
            <h2>Welcome back to HealthTrack.</h2>
            <p class="mt-3">Your plans, logs and appointments are waiting. Sign in to pick up where you left off.</p>
        </div>
        <div class="demo-accounts">
            <div class="fw-bold mb-2 text-white"><i class="bi bi-key"></i> Demo accounts</div>
            <div>Admin: <code>admin@healthtrack.com</code> / <code>Admin@123</code></div>
            <div>Trainer: <code>trainer@healthtrack.com</code> / <code>Trainer@123</code></div>
            <div>Client: <code>client@healthtrack.com</code> / <code>Client@123</code></div>
        </div>
    </div>
    <div class="auth-form">
        <h1 class="h3 mb-1">Sign in</h1>
        <p class="text-muted mb-4">New here? <a asp-action="Register">Create an account</a></p>

        <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="mb-3"></div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" autocomplete="username" autofocus />
                <span asp-validation-for="Email" class="field-validation-error"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="Password" class="field-validation-error"></span>
            </div>
            <div class="form-check mb-4">
                <input asp-for="RememberMe" class="form-check-input" />
                <label asp-for="RememberMe" class="form-check-label"></label>
            </div>
            <button type="submit" class="btn btn-primary w-100 py-2">Sign in</button>
        </form>
        <p class="small text-muted mt-4 mb-0"><i class="bi bi-shield-check"></i> After 5 failed attempts the account is locked for 15 minutes.</p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
