@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Change password";
}
<div class="page-head">
    <div>
        <h1>Change password</h1>
        <p>Choose a strong password you don't use anywhere else.</p>
    </div>
    <a class="btn btn-outline-primary" asp-action="Profile"><i class="bi bi-arrow-left"></i> Back to profile</a>
</div>
<div class="panel" style="max-width:560px">
    <form asp-action="ChangePassword" method="post" novalidate>
        <div asp-validation-summary="ModelOnly" class="mb-3"></div>
        <div class="mb-3">
            <label asp-for="CurrentPassword" class="form-label"></label>
            <input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" />
            <span asp-validation-for="CurrentPassword" class="field-validation-error"></span>
        </div>
        <div class="mb-3">
            <label asp-for="NewPassword" class="form-label"></label>
            <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
            <div class="form-text">At least 8 characters with upper-case, lower-case, a number and a symbol.</div>
            <span asp-validation-for="NewPassword" class="field-validation-error"></span>
        </div>
        <div class="mb-4">
            <label asp-for="ConfirmNewPassword" class="form-label"></label>
            <input asp-for="ConfirmNewPassword" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="ConfirmNewPassword" class="field-validation-error"></span>
        </div>
        <button type="submit" class="btn btn-primary">Update password</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
