@model RegisterViewModel
@{
    ViewData["Title"] = "Create account";
}
<div class="auth-wrap">
    <div class="auth-side">
        <div>
            <h2>Start tracking what matters.</h2>
            <p class="mt-3">Clients can start logging straight away. Trainer accounts are reviewed by an administrator before first sign-in.</p>
        </div>
        <ul class="list-unstyled small mb-0" style="color:#b9d6ce">
            <li class="mb-2"><i class="bi bi-check2-circle"></i> Personalised workout &amp; diet plans</li>
            <li class="mb-2"><i class="bi bi-check2-circle"></i> Progress charts for weight, BMI and calories</li>
            <li><i class="bi bi-check2-circle"></i> Sensitive health notes encrypted at rest</li>
        </ul>
    </div>
    <div class="auth-form" style="max-width:600px">
        <h1 class="h3 mb-1">Create your account</h1>
        <p class="text-muted mb-4">Already registered? <a asp-action="Login">Sign in</a></p>

        <form asp-action="Register" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="mb-3"></div>

            <div class="mb-3">
                <label class="form-label">I'm joining as</label>
                <div class="d-flex gap-3">
                    <div class="form-check">
                        <input class="form-check-input" type="radio" asp-for="AccountType" value="Client" id="typeClient" />
                        <label class="form-check-label" for="typeClient">Client</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" asp-for="AccountType" value="Trainer" id="typeTrainer" />
                        <label class="form-check-label" for="typeTrainer">Trainer / health professional</label>
                    </div>
                </div>
                <span asp-validation-for="AccountType" class="field-validation-error"></span>
            </div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="FullName" class="form-label"></label>
                    <input asp-for="FullName" class="form-control" autocomplete="name" />
                    <span asp-validation-for="FullName" class="field-validation-error"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" autocomplete="email" />
                    <span asp-validation-for="Email" class="field-validation-error"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Password" class="form-label"></label>
                    <input asp-for="Password" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="Password" class="field-validation-error"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="ConfirmPassword" class="form-label"></label>
                    <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>
                </div>
                <div class="col-12 form-text mt-1">At least 8 characters with upper-case, lower-case, a number and a symbol.</div>

                <div class="col-md-6" id="specialisationField">
                    <label asp-for="Specialization" class="form-label"></label>
                    <input asp-for="Specialization" class="form-control" placeholder="e.g. Strength coach, Nutritionist" />
                    <span asp-validation-for="Specialization" class="field-validation-error"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="PhoneNumber" class="form-label"></label>
                    <input asp-for="PhoneNumber" class="form-control" autocomplete="tel" placeholder="0771234567" />
                    <span asp-validation-for="PhoneNumber" class="field-validation-error"></span>
                </div>
                <div class="col-md-4 client-field">
                    <label asp-for="DateOfBirth" class="form-label"></label>
                    <input asp-for="DateOfBirth" class="form-control" max="@DateTime.Today.AddYears(-13).ToString("yyyy-MM-dd")" />
                    <span asp-validation-for="DateOfBirth" class="field-validation-error"></span>
                </div>
                <div class="col-md-4 client-field">
                    <label asp-for="Gender" class="form-label"></label>
                    <select asp-for="Gender" asp-items="Html.GetEnumSelectList<GenderType>()" class="form-select">
                        <option value="">Prefer not to say</option>
                    </select>
                </div>
                <div class="col-md-4 client-field">
                    <label asp-for="HeightCm" class="form-label"></label>
                    <input asp-for="HeightCm" class="form-control" step="0.1" />
                    <span asp-validation-for="HeightCm" class="field-validation-error"></span>
                </div>
            </div>

            <div class="form-check mt-4">
                <input asp-for="AcceptPrivacyPolicy" class="form-check-input" />
                <label class="form-check-label" asp-for="AcceptPrivacyPolicy">
                    I agree to the <a asp-controller="Home" asp-action="Privacy" target="_blank">privacy policy</a> and consent to my health data being stored securely.
                </label>
                <div><span asp-validation-for="AcceptPrivacyPolicy" class="field-validation-error"></span></div>
            </div>

            <button type="submit" class="btn btn-primary w-100 py-2 mt-4">Create account</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Show the specialisation field only for trainers, and body details only for clients.
        (function () {
            const radios = document.querySelectorAll('input[name="AccountType"]');
            function refresh() {
                const isTrainer = document.getElementById('typeTrainer').checked;
                document.getElementById('specialisationField').style.display = isTrainer ? '' : 'none';
                document.querySelectorAll('.client-field').forEach(el => el.style.display = isTrainer ? 'none' : '');
            }
            radios.forEach(r => r.addEventListener('change', refresh));
            refresh();
        })();
    </script>
}
